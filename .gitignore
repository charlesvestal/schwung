/build/
/dist/
/schwung.tar.gz
/libs/quickjs/quickjs-2025-04-26/.obj/
/libs/quickjs/quickjs-2025-04-26/libquickjs.a
/.worktrees
*.tar.gz
*.tar

# Test patches (kept locally, not committed)
/src/modules/chain/test_patches/

