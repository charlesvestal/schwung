diff --git a/src/sfizz/FilePool.cpp b/src/sfizz/FilePool.cpp
index fa7e5afb..edea8430 100644
--- a/src/sfizz/FilePool.cpp
+++ b/src/sfizz/FilePool.cpp
@@ -44,6 +44,8 @@
 #include <windows.h>
 #else
 #include <pthread.h>
+#include <sched.h>      /* SCHWUNG: SCHED_OTHER, sched_param -- see globalThreadPool() */
+#include <cstring>      /* SCHWUNG: memset */
 #endif
 using namespace std::placeholders;
 
@@ -65,7 +67,53 @@ static std::shared_ptr<ThreadPool> globalThreadPool()
 
     unsigned numThreads = std::thread::hardware_concurrency();
     numThreads = (numThreads > 2) ? (numThreads - 2) : 1;
+
+    /*
+     * SCHWUNG LOCAL PATCH -- do not drop when updating sfizz.
+     *
+     * These pool threads must not be born realtime.
+     *
+     * On Ableton Move, sfizz is loaded as a Schwung plugin whose entry points
+     * run on the SPI audio callback: SCHED_FIFO 70, pinned to core 3. This
+     * function is reached from create_instance, and PTHREAD_INHERIT_SCHED is
+     * the POSIX default, so every thread ThreadPool spawns inherited FIFO 70.
+     * Measured on hardware 2026-08-22: FIVE realtime threads from this one
+     * pool, the largest single contribution in the whole module fleet.
+     *
+     * That is not merely untidy. Move's own Link Audio publisher, `Link Main`,
+     * runs at SCHED_FIFO 35, so a file-loading pool above it starves Move's
+     * audio and produces device-wide dropouts -- not glitches in this plugin.
+     *
+     * Rather than modify ThreadPool (which would be a much larger diff against
+     * upstream, and this is the only place it is constructed), demote the
+     * CREATING thread for the duration of the construction so the pool inherits
+     * normal priority, then put the caller back exactly as it was. The window
+     * is just the thread spawns, and on a recent Schwung -- which builds sound
+     * generators on a normal-priority loader thread -- this is already
+     * SCHED_OTHER and the whole block is a no-op.
+     */
+#if !defined(_WIN32)
+    int savedPolicy = SCHED_OTHER;
+    struct sched_param savedParam;
+    memset(&savedParam, 0, sizeof(savedParam));
+    const bool haveSaved =
+        (pthread_getschedparam(pthread_self(), &savedPolicy, &savedParam) == 0);
+
+    if (haveSaved && savedPolicy != SCHED_OTHER) {
+        struct sched_param otherParam;
+        memset(&otherParam, 0, sizeof(otherParam));
+        pthread_setschedparam(pthread_self(), SCHED_OTHER, &otherParam);
+    }
+
+    threadPool.reset(new ThreadPool(numThreads));
+
+    if (haveSaved && savedPolicy != SCHED_OTHER)
+        pthread_setschedparam(pthread_self(), savedPolicy, &savedParam);
+#else
     threadPool.reset(new ThreadPool(numThreads));
+#endif
+    /* END SCHWUNG LOCAL PATCH */
+
     globalThreadPoolWeakPtr = threadPool;
     return threadPool;
 }
